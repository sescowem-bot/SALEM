# Supabase — Salem Medical Laboratories
#
# Copy this file to .env.local (for Next.js local dev) and fill in the real
# values from your Supabase project settings (Project Settings -> API).
#
# The same URL/anon key pair also drives Supabase Auth (staff sign-in at
# /admin/login) — no separate auth-specific variables are required.

# Safe to expose in the browser bundle (NEXT_PUBLIC_ prefix required by Next.js).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Never prefix this with NEXT_PUBLIC_. Never import the module
# that reads this variable (src/lib/supabase/service-client.ts) from a Client
# Component. This key bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Email notifications (Advanced 6 — Notifications & Patient Result Delivery)
#
# Optional. If RESEND_API_KEY and EMAIL_FROM_ADDRESS are both unset, the app
# still records every notification in the `notifications` table (for the
# Admin Notification Center at /admin/notifications) but honestly marks each
# one "failed" with "No email provider is configured" instead of claiming a
# delivery that didn't happen. See src/lib/email/provider.ts.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Absolute base URL of this deployment (no trailing slash), used to build
# links inside notification emails, e.g. https://salemmedicallabs.com.
# Safe to expose in the browser bundle.
NEXT_PUBLIC_SITE_URL=
