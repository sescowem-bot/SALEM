# Supabase — Salem Medical Laboratories
#
# Copy this file to .env.local (for Next.js local dev) and fill in the real
# values from your Supabase project settings (Project Settings -> API).
#
# The same URL/anon key pair also drives Supabase Auth (staff sign-in at
# /admin/login) — no separate auth-specific variables are required.

# Safe to expose in the browser bundle (NEXT_PUBLIC_ prefix required by Next.js).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Never prefix this with NEXT_PUBLIC_. Never import the module
# that reads this variable (src/lib/supabase/service-client.ts) from a Client
# Component. This key bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=
